HERE="$(dirname "$(readlink -f "${0}")")" 
export running=${0##*/} BCyan='\e[1;36m' CReset="\e[m" DIRCONFIG="$HOME/.config/keshiki/" socketfile="/tmp/mpv_socket_${USER}"

export PATH="${HERE}/bin:${HOME}/.local/bin:${HOME}/.deno/bin:${PATH}" last_wall="${DIRCONFIG}last_wallpaper.txt"
JS_ARG=""

if command -v deno >/dev/null 2>&1; then
    JS_ARG="--js-runtimes deno"
elif command -v node >/dev/null 2>&1; then
    JS_ARG="--js-runtimes node"
elif command -v qjs >/dev/null 2>&1; then
    JS_ARG="--js-runtimes quickjs"
fi

[ -f "${DIRCONFIG}keshiki.cfg" ] && source "${DIRCONFIG}keshiki.cfg"

if [ -z "$1" ]; then 
    [ -f "$last_wall" ] && wallpaper=$(cat "$last_wall") || exit 0
else 
    wallpaper="${1}"
    [ -f "$last_wall" ] && grep -qF "${1}" "$last_wall" || echo "${1}" > "$last_wall"
fi

if [[ ! "$wallpaper" =~ ^https:// ]]; then
    if [ ! -f "$wallpaper" ]; then 
        yad --window-icon=state-error --image=emblem-error \
        --height=139 --center --fixed --title="Error" --button=gtk-ok \
        --text="\nNo se puede acceder al archivo o URL:   \n$wallpaper   "
        exit 1
    fi
fi

launch_wallpaper(){ 
    echo -e "\n${BCyan}${wallpaper}${CReset}\n"
    "${HERE}/keshiki-cli" -f; sleep 0.2s
    xwi_args="-fs -sp -st -nf -s -fdt -o $opacity"
    mpv_args="-wid WID --loop ${audio[1]} --volume=${audio[2]} --no-osc --input-ipc-server=$socketfile --no-osd-bar --no-border --no-resume-playback --input-vo-keyboard=no $wallpaper"

    if [[ "$wallpaper" =~ ^https:// ]]; then
    YTDL_OPTS=""
    if [ -n "$JS_ARG" ]; then
        # Extraer solo el nombre del runtime (ej: "deno", "node" o "quickjs")
        RUNTIME_NAME="${JS_ARG#--js-runtimes }"
        YTDL_OPTS="--ytdl-raw-options=js-runtimes=${RUNTIME_NAME}"
    fi
        xwinwrap $xwi_args --  mpv.bash $mpv_args $YTDL_OPTS \
        --ytdl-format="bestvideo[height<=720][ext=mp4]+bestaudio[ext=m4a]/best[ext=mp4]/best"
    else
        xwinwrap $xwi_args -- mpv.bash $mpv_args
    fi
}

( [ "$below_desk" = TRUE ] && if pidof nemo-desktop >/dev/null; then sleep 1.39s
    Name_DESK=$(wmctrl -l | cut -d' ' -f4-7 | grep -e '^Escritorio$' -e '^Desktop$')
    Desktop_ID=$(xdotool search --name "^$Name_DESK$" | head -1)
     wmctrl -ia "$Desktop_ID"
fi ) &

launch_wallpaper &
sleep 0.39s

(
    last_state="unknown"
    while pidof -x mpv.bash >/dev/null; do
        WINDOW_ID=$(xdotool getactivewindow)
        if [ -n "$WINDOW_ID" ]; then
            WM_STATE=$(xprop -id "$WINDOW_ID" _NET_WM_STATE)
            
            if [[ "$WM_STATE" == *"_NET_WM_STATE_MAXIMIZED_HORZ"* && "$WM_STATE" == *"_NET_WM_STATE_MAXIMIZED_VERT"* ]] || \
               [[ "$WM_STATE" == *"_NET_WM_STATE_FULLSCREEN"* ]]; then
                if [ "$last_state" != "paused" ]; then
                    echo '{ "command": ["set_property", "pause", true] }' | socat - "$socketfile"
                    last_state="paused"
                fi
            else
                if [ "$last_state" != "playing" ]; then
                    echo '{ "command": ["set_property", "pause", false] }' | socat - "$socketfile"
                    last_state="playing"
                fi
            fi
        fi
        sleep 0.8s
    done
) >/dev/null 2>&1 &

